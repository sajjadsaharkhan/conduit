# Copy to .env and adjust. Every port Conduit uses is set here; nothing else hard-codes them.

# Image to run. Pin CONDUIT_TAG to a release (v1.2.3) or a commit (7-char sha) on production;
# deploy/deploy.sh rewrites it on every deploy and rollback.
CONDUIT_IMAGE=ghcr.io/sajjadsaharkhan/conduit
CONDUIT_TAG=latest
# bridge: Docker-published ports (docker-compose.deploy.yml). host: host networking, lowest latency
# on Linux (docker-compose.host.yml); the ports below must then be free on the host.
CONDUIT_NETWORK=bridge

# Web UI + /api (nginx)
CONDUIT_WEB_PORT=7782
# API (uvicorn) - internal to the container, never published
CONDUIT_API_PORT=8000

# Hybrid proxies: follow the Domains rules, everything else goes direct
CONDUIT_HYBRID_HTTP_PORT=8080
CONDUIT_HYBRID_SOCKS_PORT=1080
# Full-tunnel proxies: everything goes through the selected node
CONDUIT_FULL_HTTP_PORT=8081
CONDUIT_FULL_SOCKS_PORT=1081
# Set a proxy port to 0 to turn that proxy off (also remove its line from the compose "ports" list).

# Initial admin login (used only when the database has no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Only if the GHCR package is private: a token with read:packages. Used with --password-stdin, never printed.
# GHCR_USER=
# GHCR_TOKEN=
